{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based attributes",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["principal", "teacher", "student", "parent"] },
        "schoolId": { "type": "string" },
        "classId": { "type": "string", "description": "For students and teachers" },
        "parentId": { "type": "string", "description": "For linking children to parents" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "Educational institution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "principalId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "principalId"]
    },
    "Class": {
      "title": "Class",
      "description": "A class or section within a school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "schoolId"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Learning task assigned by teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "classId", "teacherId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "School details"
    },
    "/schools/{schoolId}/classes/{classId}": {
      "schema": "Class",
      "description": "Classes within a school"
    },
    "/schools/{schoolId}/classes/{classId}/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Assignments for a specific class"
    }
  }
}
