rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Role helpers
    function hasRole(role) {
      return isSignedIn() && getUser(request.auth.uid).role == role;
    }

    // --- User Profiles ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 100
          && data.role in ['principal', 'teacher', 'student', 'parent']
          && (data.displayName is string && data.displayName.size() <= 64)
          && (data.schoolId == null || isValidId(data.schoolId))
          && data.createdAt is string;
      }

      allow get: if isSignedIn() && (isOwner(userId) || hasRole('principal') || hasRole('teacher'));
      allow list: if isSignedIn() && (hasRole('principal') || hasRole('teacher')) && resource.data.schoolId == getUser(request.auth.uid).schoolId;
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().role == existing().role // Role immutability
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
    }

    // --- Schools ---
    match /schools/{schoolId} {
      function isValidSchool(data) {
        return data.name is string && data.name.size() <= 128
          && data.principalId == request.auth.uid
          && data.inviteCode is string && data.inviteCode.size() == 6;
      }

      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidSchool(incoming());
      allow update: if isOwner(existing().principalId) && isValidSchool(incoming());
      
      // Classes Subcollection
      match /classes/{classId} {
        function isValidClass(data) {
          return data.name is string && data.name.size() <= 64
            && data.schoolId == schoolId;
        }

        allow read: if isSignedIn() && getUser(request.auth.uid).schoolId == schoolId;
        allow create: if hasRole('principal') && isValidClass(incoming());
        allow update: if (hasRole('principal') || hasRole('teacher')) && isValidClass(incoming());
      }
    }
  }
}
